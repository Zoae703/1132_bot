* text=auto

# C/C++ source: always LF
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf

# Assembly and linker scripts: always LF
*.s text eol=lf
*.S text eol=lf
*.ld text eol=lf

# STM32CubeMX project: always LF (XML-based)
*.ioc text eol=lf

# Build system: always LF
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts
*.py text eol=lf
*.sh text eol=lf

# Windows scripts: CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
