{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32: Debug (gdb-multiarch)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}/firmware",
            "executable": "${workspaceFolder}/firmware/build/Debug/1132_bot.elf",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/firmware/openocd.cfg"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "parsed",
            "preLaunchTask": "STM32: Build Debug",
            "gdbPath": "gdb-multiarch",
            "postLaunchCommands": [
                "monitor arm semihosting enable"
            ],
            "liveWatch": {
                "enabled": true,
                "samples": 50
            }
        },
        {
            "name": "STM32: Debug (ARM GDB)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}/firmware",
            "executable": "${workspaceFolder}/firmware/build/Debug/1132_bot.elf",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/firmware/openocd.cfg"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "parsed",
            "preLaunchTask": "STM32: Build Debug",
            "gdbPath": "arm-none-eabi-gdb",
            "postLaunchCommands": [
                "monitor arm semihosting enable"
            ],
            "liveWatch": {
                "enabled": true,
                "samples": 50
            }
        },
        {
            "name": "STM32: Attach (gdb-multiarch)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}/firmware",
            "executable": "${workspaceFolder}/firmware/build/Debug/1132_bot.elf",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/firmware/openocd.cfg"
            ],
            "showDevDebugOutput": "parsed",
            "gdbPath": "gdb-multiarch",
            "liveWatch": {
                "enabled": true,
                "samples": 50
            }
        },
        {
            "name": "STM32: Attach (ARM GDB)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}/firmware",
            "executable": "${workspaceFolder}/firmware/build/Debug/1132_bot.elf",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/firmware/openocd.cfg"
            ],
            "showDevDebugOutput": "parsed",
            "gdbPath": "arm-none-eabi-gdb",
            "liveWatch": {
                "enabled": true,
                "samples": 50
            }
        }
    ]
}
