{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build build/Debug -j$(nproc)",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "STM32: build",
      "type": "shell",
      "command": "cmake --build build/Debug -j$(nproc)",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "STM32: flash DAPLink",
      "type": "shell",
      "command": "${config:cortex-debug.openocdPath}",
      "args": [
        "-f",
        "${workspaceFolder}/openocd.cfg",
        "-c",
        "program ${workspaceFolder}/build/Debug/1132_bot.elf verify reset exit"
      ],
      "dependsOn": "STM32: build",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
