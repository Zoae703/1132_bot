{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: Configure Debug",
            "type": "cmake",
            "command": "configure",
            "preset": "Debug",
            "problemMatcher": []
        },
        {
            "label": "STM32: Build Debug",
            "type": "cmake",
            "command": "build",
            "targets": ["all"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "STM32: Configure Release",
            "type": "cmake",
            "command": "configure",
            "preset": "Release",
            "problemMatcher": []
        },
        {
            "label": "STM32: Build Release",
            "type": "cmake",
            "command": "build",
            "targets": ["all"],
            "preset": "Release",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "STM32: Flash",
            "type": "cmake",
            "command": "build",
            "targets": ["flash"],
            "preset": "Debug",
            "problemMatcher": []
        },
        {
            "label": "STM32: Clean",
            "type": "cmake",
            "command": "clean",
            "preset": "Debug",
            "problemMatcher": []
        },
        {
            "label": "STM32: Check Environment",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/firmware/scripts/check_env.py"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
